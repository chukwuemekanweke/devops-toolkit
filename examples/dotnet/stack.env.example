# Non-secret placeholder values standing in for the host-owned stack.env so
# release-config-check.yml can render the Compose file on pull requests. The real
# values live only in <deployment-path>/stack.env on the host. Never put secrets here.
APP_UID=1654
WEBAPI_SECRETS_GID=10001
CONSUMER_SECRETS_GID=10002
JOBS_SECRETS_GID=10003
DATABASE_MIGRATOR_SECRETS_GID=10004
