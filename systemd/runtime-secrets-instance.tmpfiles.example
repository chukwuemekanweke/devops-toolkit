# Install one root-owned file per instance under /etc/tmpfiles.d and replace the example identities.
# Parents are root-owned and not writable by the render identity; only the exact service leaf is writable.
d /run/runtime-secrets/example-backend 0711 root root -
d /run/runtime-secrets/example-backend/prd 0711 root root -
d /run/runtime-secrets/example-backend/prd/webapi 0700 rsec-exb-prd-api rsec-exb-prd-api -
