[Unit]
Description=Docker Compose application stack %i (active vps-deploy release)
Documentation=https://github.com/chukwuemekanweke/devops-toolkit/blob/main/docs/vps-deployment.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/vps-deploy/stacks/%i.json
# Stacks with boot-time runtime secrets add a drop-in generated by
#   node /opt/vps-deploy/scripts/vps-deploy-host.mjs boot-dropin --stack %i
# declaring Requires= and After= on each runtime-secrets-initialize@<instance>.service.
# A failed initializer (for example Doppler unavailable at boot) therefore keeps
# this stack stopped; secret-bearing services use restart: "no" so Docker cannot
# start them independently.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/node /opt/vps-deploy/scripts/vps-deploy-host.mjs start --stack %i
ExecStop=/usr/bin/node /opt/vps-deploy/scripts/vps-deploy-host.mjs stop --stack %i
TimeoutStartSec=900
TimeoutStopSec=330
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
LockPersonality=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
