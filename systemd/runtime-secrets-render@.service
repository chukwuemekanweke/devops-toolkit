[Unit]
Description=Render pending runtime secrets for %i
Documentation=https://github.com/chukwuemekanweke/devops-toolkit/tree/main/docs/doppler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rsec-%i
Group=rsec-%i
UMask=0027
LoadCredentialEncrypted=doppler-token:/etc/credstore.encrypted/runtime-secrets-%i.token
ExecStart=/usr/bin/node /opt/runtime-secrets/scripts/runtime-secrets.mjs render --instance /etc/runtime-secrets/instances/%i.json
Environment=HOME=/tmp
Environment=TMPDIR=/tmp
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @privileged
ReadOnlyPaths=/etc/runtime-secrets
ReadWritePaths=/run/runtime-secrets
LimitCORE=0
StandardOutput=journal
StandardError=journal

# The service user must own only its app/environment directory. Host installation must add a
# per-instance drop-in with an exact ReadWritePaths= path when stronger mount-namespace isolation
# is required; Unix 0700 ownership remains mandatory in either case.
