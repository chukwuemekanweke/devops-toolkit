# Replace INSTANCE with the reviewed instance name. This grants no arbitrary command execution and
# no Docker access. Keep render, activation, discard and restore as separate auditable journal events.
%runtime-secrets-deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start runtime-secrets-render@INSTANCE.service
%runtime-secrets-deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start runtime-secrets-activate@INSTANCE.service
%runtime-secrets-deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start runtime-secrets-discard@INSTANCE.service
%runtime-secrets-deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start runtime-secrets-restore@INSTANCE.service
