{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chukwuemekanweke/devops-toolkit/blob/main/docs/schemas/deployment-manifest.schema.json",
  "title": "DevOps Toolkit deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "source_repository",
    "source_commit",
    "build_reference",
    "created_at",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "build_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "digest"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
