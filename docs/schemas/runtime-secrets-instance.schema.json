{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chukwuemekanweke/devops-toolkit/docs/schemas/runtime-secrets-instance.schema.json",
  "title": "Runtime secrets host instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "application", "environment", "service", "expectedDopplerProject", "expectedDopplerConfig", "outputDirectory", "serviceGroupId", "keyManifestPath"],
  "properties": {
    "version": { "const": 1 },
    "application": { "$ref": "#/$defs/identity" },
    "environment": { "$ref": "#/$defs/identity" },
    "service": { "$ref": "#/$defs/identity" },
    "expectedDopplerProject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "expectedDopplerConfig": { "type": "string", "minLength": 1, "maxLength": 200 },
    "outputDirectory": { "type": "string", "pattern": "^/run/runtime-secrets/" },
    "serviceGroupId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "keyManifestPath": { "type": "string", "pattern": "^/etc/runtime-secrets/manifests/" },
    "maxPayloadBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216, "default": 1048576 },
    "maxSecretBytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 65536 },
    "providerTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
    "providerRetries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 2 },
    "dopplerExecutable": { "type": "string", "minLength": 1, "default": "/usr/local/bin/doppler" },
    "dopplerCliVersion": { "const": "3.77.0" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
  }
}
