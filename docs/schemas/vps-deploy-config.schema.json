{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chukwuemekanweke/devops-toolkit/docs/schemas/vps-deploy-config.schema.json",
  "title": "vps-deploy deployment configuration",
  "description": "Application-owned file named by the deploy-config-path input of vps-deploy.yml and release-config-check.yml. It replaces the inline topology inputs; each field is validated exactly like the inline input it replaces. environment, stack-name, and ssh-port stay workflow inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "composeFiles", "remoteDeploymentPath"],
  "properties": {
    "version": { "const": 1 },
    "composeFiles": {
      "description": "Repository-relative Compose files, applied in order (compose-files).",
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "maxLength": 256, "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}/)*[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}\\.ya?ml$" }
    },
    "remoteDeploymentPath": {
      "description": "Absolute deployment root registered for this stack on the host (remote-deployment-path).",
      "type": "string", "pattern": "^(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){2,16}$"
    },
    "componentServiceMap": {
      "description": "Manifest component to Compose service name; omitted components use the same name (component-service-map).",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$" }
    },
    "migrationService": {
      "description": "One-shot Compose migration service; empty or omitted disables migration (migration-service).",
      "type": "string", "pattern": "^(?:[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62})?$"
    },
    "migrationTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200, "default": 600 },
    "healthServices": {
      "description": "Services that must become healthy; omitted verifies all long-running services (health-services).",
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$" }
    },
    "healthChecks": {
      "description": "Host-side HTTP checks (health-checks).",
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$" },
          "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://\\S+$" },
          "expectedStatus": {
            "oneOf": [
              { "type": "integer", "minimum": 100, "maximum": 599 },
              { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
            ]
          }
        }
      }
    },
    "healthTimeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 300 },
    "rollbackOnHealthFailure": { "type": "boolean", "default": true }
  }
}
