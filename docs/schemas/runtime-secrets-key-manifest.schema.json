{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chukwuemekanweke/devops-toolkit/docs/schemas/runtime-secrets-key-manifest.schema.json",
  "title": "Runtime secrets key manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "secrets"],
  "properties": {
    "version": { "const": 1 },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "allowEmpty"],
        "properties": {
          "name": { "type": "string", "pattern": "^(?!DOPPLER_)(?![0-9])[A-Z0-9_]{1,200}$" },
          "required": { "type": "boolean" },
          "allowEmpty": { "type": "boolean" },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
        }
      }
    }
  }
}
